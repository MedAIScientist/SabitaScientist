# EvoScientist Production — copy to deploy/.env and fill in
# (API keys from ../.env are inherited automatically)

# LLM provider (pick at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Web search (optional)
TAVILY_API_KEY=

# Garage S3 (change these in production!)
GARAGE_ACCESS_KEY=GK1234567890abc
GARAGE_SECRET_KEY=abcdef1234567890abcdef1234567890
GARAGE_BUCKET=evoscientist

# PM database path (inside the /data volume)
EVOSCIENTIST_PM_DB=/data/pm.db

# PM OIDC issuer (set to Authentik URL when using Authentik, e.g. http://localhost:9000/application/o/evoscientist-pm/)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:7860/api/v1/auth/oidc/callback
OIDC_SCOPE=openid email profile

# Microsoft OAuth credentials (for Authentik Microsoft source)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common

# Authentik admin credentials
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@evoscientist.local
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_POSTGRES_PASSWORD=
AUTHENTIK_POSTGRESQL__PASSWORD=
